# Copy to .env.cloud locally. Never commit real values.
# Setup only: postgres direct/session connection (5432)
MIGRATION_DATABASE_URL="postgresql://postgres.PROJECT_REF:ADMIN_PASSWORD@POOLER_HOST:5432/postgres"
QUALITY_DB_PASSWORD="replace-with-at-least-24-random-characters"

# Runtime: restricted role through transaction pooling (6543)
DATABASE_URL="postgresql://qualitrack_app.PROJECT_REF:APP_PASSWORD@POOLER_HOST:6543/postgres"
DATABASE_SSL="true"
DATABASE_POOL_MAX="3"
# Optional CA PEM; literal \n is accepted.
DATABASE_CA_CERT=""

APP_URL="https://YOUR_PROJECT.vercel.app"
VITE_API_URL="/api"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="8h"
MEDIA_STORAGE="supabase"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_REPLACE"
SUPABASE_STORAGE_BUCKET="quality-evidence"
CRON_SECRET="replace-with-at-least-32-random-characters"

# Optional push configuration
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
