{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "maxDuration": 60, "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs", "excludeFiles": "{on-premise,tests,tools,marketing,assets,.runtime,.npm-cache,dist-server,website}/**" } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] }
  ],
  "crons": [{ "path": "/api/cron/notifications", "schedule": "0 6 * * *" }]
}
