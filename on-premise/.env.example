# Web and API
APP_URL="http://localhost:3000"
API_PORT="3001"
VITE_API_URL="/api"
MEDIA_ROOT=".data/media"

# Kurum içi PostgreSQL
DATABASE_URL="postgresql://qualitrack_app:CHANGE_ME@localhost:5432/qualitrack_onprem"
DATABASE_SSL="false"

# Authentication (üretimde en az 32 karakterli rastgele değer)
JWT_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
JWT_EXPIRES_IN="8h"

# Yalnızca ilk kurulumda `npm run db:seed` tarafından kullanılır
ONPREM_COMPANY_NAME="Kurum Adı"
ONPREM_ADMIN_NAME="Sistem Yöneticisi"
ONPREM_ADMIN_EMAIL="admin@example.local"
ONPREM_ADMIN_PASSWORD="CHANGE_ME_NOW"
