# Web and API
APP_URL="http://localhost:3000"
API_PORT="3001"
VITE_API_URL="/api"

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qualitrack"
DATABASE_SSL="false"

# Authentication (production: at least 32 random characters)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Stripe (server-side secrets must never use the VITE_ prefix)
BILLING_ENABLED="false"
# Account email: enable only after verifying the sender domain.
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_MONTHLY_PRICE_ID="price_..."
STRIPE_STARTER_ANNUAL_PRICE_ID="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_ANNUAL_PRICE_ID="price_..."
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID="price_..."
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID="price_..."

# Server-only drawing analysis
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# Server-only exact workspace slugs with unlimited pilot access. Empty disables it.
UNLIMITED_PILOT_WORKSPACES=""

# Server-only immutable user IDs allowed to administer every tenant. Empty denies all.
PLATFORM_ADMIN_USER_IDS=""
